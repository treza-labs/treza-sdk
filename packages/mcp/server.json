{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.treza-labs/treza",
  "description": "Manage secure enclaves (TEEs) with attestation, PII redaction, payments, and signing for AI agents.",
  "repository": {
    "url": "https://github.com/treza-labs/treza-sdk",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@treza/mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Treza Platform API base URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "TREZA_BASE_URL"
        },
        {
          "description": "Request timeout in milliseconds",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "TREZA_TIMEOUT"
        },
        {
          "description": "API key (treza_live_...) for authenticated tools like PII redaction and audit",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "TREZA_API_KEY"
        },
        {
          "description": "Tenant account the API key belongs to",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "TREZA_ACCOUNT"
        }
      ]
    }
  ]
}
